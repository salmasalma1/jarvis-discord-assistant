# ---------- 1) DISCORD ----------
# From: https://discord.com/developers/applications  -> Application -> Bot -> Reset Token -> Copy
DISCORD_TOKEN=your_discord_bot_token_here
# Server (guild) ID: enable Developer Mode in Discord, right-click your server -> Copy Server ID
DISCORD_GUILD_ID=your_server_id_here

# ---------- 2) GEMINI (the LLM) ----------
# From: https://aistudio.google.com  -> Get API key -> Create API key -> Copy
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- 3) GITHUB ----------
# From: https://github.com/settings/tokens  -> Generate new token (fine-grained)
#   scopes: Contents read/write + Pull requests read/write on the NELLY repo
GITHUB_TOKEN=your_github_fine_grained_token_here

# ---------- 4) TRELLO ----------
# API key from: https://trello.com/power-ups/admin
# Token: the "Token" link next to your API key on the same page
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here
# Board ID = the part after trello.com/b/ in your "Grad-prj" board URL
TRELLO_BOARD_ID=your_trello_board_id_here
# (optional) Public links shown by /links — so the team can always find things.
TRELLO_BOARD_URL=https://trello.com/b/your_board_slug
REPO_URL=https://github.com/your-org/nelly
DOCS_URL=https://github.com/your-org/nelly/tree/main/docs

# ---------- Roles / Channels ----------
# Any member with one of these roles is treated as the Owner (gets alerts).
OWNER_ROLES=Owner,Lead
# Map lane label -> role name (used by the guard to attribute commits).
TEAM_ROLES={"T1":"Team 1","T2":"Team 2","T3":"Team 3"}
# Role that flags items for the TA/reviewer.
REVIEW_ROLE=TA-Review
# Channel where JARVIS posts architecture alerts.
ALERT_CHANNEL=jarvis-alerts
# ONLY respond in this channel (e.g. "owner") while testing/private.
# Leave empty to allow all channels. Set to the name of your "#owner" channel.
ALLOWED_CHANNEL=owner_chat
# Channels where JARVIS replies to NORMAL (un-@mentioned) messages.
# It ALWAYS replies when @JARVIS'd or in a DIRECT MESSAGE.
# Empty / unset = reply ONLY on mention + DM (no spam anywhere). DEFAULT.
# To also allow plain chat in a dedicated bot channel, set it (comma-separated):
BOT_CHANNELS=
# Send a DM to the owner on high-severity deviations.
DM_ON_HIGH=true
# Block merging into integration when a high-severity deviation is open.
GATE_MERGE=true

# Password required to upload a document/chapter into the RAG index (/ingest-doc).
RAG_INGEST_PASSWORD=your_secret_password

# ---------- Whisper / DB ----------
WHISPER_MODEL=small
DB_PATH=./data/neely.db
